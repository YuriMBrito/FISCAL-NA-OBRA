rules_version = '2';

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║  FISCAL NA OBRA — Regras de Segurança Firestore                         ║
// ║                                                                          ║
// ║  POLÍTICA (27/10/2026) — o papel voltou, agora por CUSTOM CLAIM          ║
// ║                                                                          ║
// ║  CONTEXTO: em 13/08/2026 a checagem de papel foi removida daqui e a      ║
// ║  escrita ficou aberta a qualquer conta autenticada. O motivo era real:   ║
// ║  o modelo antigo usava                                                   ║
// ║     lista.hasAny([{'uid': ..., 'perfil': ...}])                          ║
// ║  que compara MAPAS INTEIROS contra registros que não têm 'uid' — a tela  ║
// ║  de usuários cadastra pessoas antes de elas terem conta. Nunca casava:   ║
// ║  só o dono da obra e o admin global escreviam, e todo o resto tomava     ║
// ║  "Missing or insufficient permissions" sem pista do motivo.              ║
// ║                                                                          ║
// ║  O QUE MUDOU AGORA: o papel não vem mais de dado cadastral. Vem de       ║
// ║  request.auth.token.role, um custom claim gravado pelo Admin SDK em      ║
// ║  criar-usuario.cjs e definir-perfil.mjs — que já faziam isso desde a     ║
// ║  v15.1, para as Storage Rules. Ou seja: a informação sempre esteve no    ║
// ║  token; o que faltava era ler dela em vez da lista.                      ║
// ║                                                                          ║
// ║  Consequências de ler do token:                                          ║
// ║   • Não há get() nem exists() em escrita → nenhuma leitura cobrada,      ║
// ║     nenhuma dependência de documento que pode não existir.               ║
// ║   • Não há como o bug de comparação de mapas voltar.                     ║
// ║   • A hierarquia é a MESMA de utils/rbac.js, então o botão que o cliente ║
// ║     esconde é o mesmo que o servidor recusa. Era essa divergência que    ║
// ║     fazia o UI liberar ação que o Firestore negava.                      ║
// ║                                                                          ║
// ║  ⚠️  CONTA SEM O CLAIM cai em papelPadrao() = 'fiscal' — o mesmo padrão  ║
// ║  conservador de criar-usuario.cjs --migrar. Negar seria trancar fora     ║
// ║  quem foi criado direto no Console antes dos claims existirem. Depois    ║
// ║  de rodar `node criar-usuario.cjs --migrar`, endurecer para              ║
// ║  'visualizador' é trocar uma linha. O claim entra no token do navegador  ║
// ║  no próximo login (ou em até 1 h).                                       ║
// ║                                                                          ║
// ║  ⚠️  O LOGIN CONTINUA SENDO A PRIMEIRA PORTA. Papel limita o que cada    ║
// ║  conta faz, não quem consegue entrar. Desabilitar o provedor Google em   ║
// ║  Authentication → Sign-in method segue obrigatório: ele aceita qualquer  ║
// ║  conta Google do mundo, e qualquer conta aceita aqui vira 'fiscal'.      ║
// ║                                                                          ║
// ║  O QUE CONTINUA BLOQUEADO PARA TODO MUNDO, e por quê:                    ║
// ║   • /usuarios/{uid} create  → qualquer conta podia se autodeclarar       ║
// ║     'administrador'. Perfis só pelo Admin SDK.                           ║
// ║   • auditoria e historico: update → trilha append-only (TCU/CGU).        ║
// ║     Criar e ler, sempre; reescrever registro passado, nunca.             ║
// ║   • lixeira: update → item de lixeira é imutável até ser restaurado.     ║
// ║   • Qualquer coleção fora de /usuarios, /obras e /lixeira.               ║
// ╚══════════════════════════════════════════════════════════════════════════╝

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    //  AUTENTICAÇÃO
    // ═══════════════════════════════════════════════════════════════

    function estaAutenticado() {
      return request.auth != null;
    }

    function meuUid() {
      return request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════════
    //  PAPÉIS — espelho de HIERARQUIA em utils/rbac.js
    //
    //  administrador 5 · gestor 4 · fiscal 3 · engenheiro 2 ·
    //  tecnico 1 · visualizador 0
    // ═══════════════════════════════════════════════════════════════

    // Papel de quem não tem o claim. Ver o aviso no cabeçalho antes de mexer.
    function papelPadrao() {
      return 'fiscal';
    }

    function papel() {
      return request.auth.token.get('role', papelPadrao());
    }

    function nivel(p) {
      return p == 'administrador' ? 5
           : p == 'gestor'        ? 4
           : p == 'fiscal'        ? 3
           : p == 'engenheiro'    ? 2
           : p == 'tecnico'       ? 1
           : 0;  // visualizador e qualquer valor desconhecido
    }

    function adminGlobal() {
      return estaAutenticado() && request.auth.token.get('adminGlobal', false) == true;
    }

    // Único portão de escrita do arquivo.
    function nivelMinimo(n) {
      return estaAutenticado() && (adminGlobal() || nivel(papel()) >= n);
    }

    // Administrador: pelo claim (sem custo) ou, para contas ainda não
    // migradas, pelo documento de perfil. O || curto-circuita, então quem
    // tem o claim não gera leitura. O .get('perfil','') evita o erro de
    // campo ausente em documento criado só com preferências.
    function souAdmin() {
      return adminGlobal()
        || (estaAutenticado()
            && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
            && get(/databases/$(database)/documents/usuarios/$(request.auth.uid))
                 .data.get('perfil', '') == 'administrador');
    }

    // ═══════════════════════════════════════════════════════════════
    //  NÍVEL EXIGIDO POR SUBCOLEÇÃO DA OBRA
    //
    //  Esta é A tabela de permissões do sistema — mudar política é mudar
    //  aqui, em um lugar só. Subcoleção que ninguém previu cai no 1
    //  (tecnico), de propósito: módulo novo nasce funcionando para a
    //  equipe de campo e não exige editar este arquivo para subir.
    // ═══════════════════════════════════════════════════════════════
    function nivelExigido(sub) {
      // Quem manda em quem tem acesso à obra: só administrador.
      return sub == 'usuarios' ? 5

        // Impacto jurídico e contratual (Lei 14.133: Art. 111, 117, 125, 156).
        // 'cfg' entra aqui porque guarda contrato, valor, prazos e CNPJs.
        : sub in ['cfg', 'sancoes', 'responsaveis', 'prazos', 'recebimentos',
                  'riscos', 'lei14133', 'versoes', 'fiscais', 'acesso'] ? 4

        // Impacto financeiro: medição é o que vira pagamento.
        : sub in ['bms', 'medicoes', 'itens', 'aditivos'] ? 2

        // Operação de campo: diario, ocorrencias, chuva, documentos,
        // notificacoes, fotos-medicao, checklist-tecnico, etapas-pac,
        // qualidade — e o que vier depois.
        : 1;
    }

    // ═══════════════════════════════════════════════════════════════
    //  /usuarios/{uid} — perfis de usuário
    // ═══════════════════════════════════════════════════════════════
    match /usuarios/{uid} {
      allow read: if estaAutenticado() && (meuUid() == uid || souAdmin());

      // BLOQUEADO no cliente: a regra antiga aceitava perfil 'administrador'
      // na criação, então qualquer conta recém-logada virava admin global.
      allow create: if false;

      // O próprio usuário só mexe em preferência. 'perfil' fica de fora por
      // construção, então não há auto-promoção.
      allow update: if estaAutenticado()
        && meuUid() == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['obraAtivaId', 'ultimoAcesso', 'atualizadoEm']);

      allow update: if souAdmin();

      // Inativar, não deletar (auditoria).
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    //  /obras/{obraId} — a obra e TODOS os seus dados
    //
    //  Inclui a obra fictícia 'global', onde o Quadro de Chuvas gravava
    //  até a v15.5.2: /obras/global/chuva/{ano} cai aqui como qualquer
    //  outra, então o histórico antigo continua legível e gravável.
    // ═══════════════════════════════════════════════════════════════
    match /obras/{obraId} {

      // Leitura: qualquer autenticado, em qualquer obra. É a política de
      // 13/08 e ela fica — a equipe precisa ver obra de colega, e esconder
      // leitura nunca foi o problema que custou dado aqui.
      allow read: if estaAutenticado();

      // O documento raiz carrega nome, tipo, statusObra e o 'uid' do dono.
      // Criar a obra também grava 'cfg' (criarObra), que exige 4 — os dois
      // no mesmo nível para não existir obra meio-criada.
      allow create, update: if nivelMinimo(4);

      // Hard-delete de contrato: só administrador. O caminho normal é a
      // lixeira (softDeleteObra), que é reversível.
      allow delete: if nivelMinimo(5);

      // ── Trilhas append-only ──────────────────────────────────────
      // Declaradas ANTES do curinga e excluídas dele: regras do Firestore
      // são aditivas (basta uma permitir), então a única forma de manter
      // update proibido é o curinga abaixo não conceder escrita a elas.
      match /auditoria/{docId} {
        allow read, create: if estaAutenticado();
        allow update: if false;
        // Antes: delete liberado a qualquer autenticado — uma trilha que
        // qualquer um apaga não é append-only.
        allow delete: if nivelMinimo(5);
      }

      match /historico/{docId} {
        allow read, create: if estaAutenticado();
        allow update: if false;
        // deleteObra() apaga 'historico' em cascata, e excluir obra é 5.
        allow delete: if nivelMinimo(5);
      }

      // ── Todo o resto dos dados da obra ───────────────────────────
      match /{subcolecao}/{documento=**} {
        allow read:  if estaAutenticado();
        allow write: if nivelMinimo(nivelExigido(subcolecao))
          && !(subcolecao in ['auditoria', 'historico']);
      }
    }

    // ═══════════════════════════════════════════════════════════════
    //  /lixeira/{itemId} — soft-delete
    //
    //  Criar item de lixeira é operação que PRESERVA dado: é por onde
    //  passam excluir aditivo, BM, entrada de diário e documento. Fica em
    //  1 (tecnico) de propósito — prender isso em gestor transformaria
    //  "apagar uma linha do diário" em pedido ao administrador.
    //  Destrutivo de verdade é só esvaziar a lixeira: 4.
    // ═══════════════════════════════════════════════════════════════
    match /lixeira/{itemId} {
      allow read:   if estaAutenticado();
      allow create: if nivelMinimo(1);
      allow update: if false;  // item de lixeira é imutável
      allow delete: if nivelMinimo(4);
    }

    // ═══════════════════════════════════════════════════════════════
    //  BLOQUEIO GLOBAL — tudo que não é /usuarios, /obras ou /lixeira
    // ═══════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
