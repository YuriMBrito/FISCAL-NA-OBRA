rules_version = '2';

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║  FISCAL NA OBRA — Regras de Segurança do Firebase Storage               ║
// ║                                                                          ║
// ║  POLÍTICA (27/10/2026) — papel vem do CUSTOM CLAIM, não da lista         ║
// ║                                                                          ║
// ║  O arquivo anterior decidia acesso por membresia na obra, com            ║
// ║    firestore.get(.../usuarios/lista).data.lista.hasAny([{'uid': ...}])   ║
// ║  que é exatamente o padrão quebrado que derrubou o modelo de papéis das  ║
// ║  Firestore Rules em 13/08/2026: hasAny com mapa compara o MAPA INTEIRO,  ║
// ║  e os registros reais da lista não têm 'uid' — a tela de usuários        ║
// ║  cadastra pessoas antes de elas terem conta (nome, email, perfil, crea,  ║
// ║  tel). A comparação nunca casava, então logo, documentos e fotos de      ║
// ║  medição só abriam para o dono da obra e para o adminGlobal. Todo o      ║
// ║  resto da equipe tomava "unauthorized" sem nenhuma pista do motivo.      ║
// ║                                                                          ║
// ║  Agora o papel sai de request.auth.token.role, gravado pelo Admin SDK    ║
// ║  em criar-usuario.cjs e definir-perfil.mjs. Não há firestore.get():      ║
// ║  nenhuma leitura cobrada, nenhuma dependência de dado cadastral, e a     ║
// ║  mesma hierarquia que o cliente usa em utils/rbac.js.                    ║
// ║                                                                          ║
// ║  O QUE MUDOU DE COMPORTAMENTO                                            ║
// ║   • Leitura de anexo: qualquer autenticado — igual ao Firestore, que já  ║
// ║     libera leitura de qualquer obra. Trancar só o anexo não protegia     ║
// ║     nada e escondia arquivo de quem já via o contrato inteiro.           ║
// ║   • docs/ e as pastas de foto: escrita de 'tecnico' para cima.           ║
// ║   • logo: 'gestor' para cima (é identidade do contrato, mora no cfg).    ║
// ║   • delete: 'gestor' para cima. Antes era adminGlobal e só — ou seja,    ║
// ║     documento anexado por engano não tinha como ser removido.            ║
// ║   • Pastas 'diario/' e 'ocorrencias/': PASSARAM A EXISTIR aqui. O app    ║
// ║     sempre enviou foto de diário e de ocorrência para elas               ║
// ║     (uploadFotoStorage), caíam no bloqueio final, e o catch devolvia o   ║
// ║     base64 — que ia inteiro para dentro do documento no Firestore,       ║
// ║     empurrando a obra contra o limite de 1 MiB por documento.            ║
// ║                                                                          ║
// ║  CONTA SEM CLAIM: cai em papelPadrao() ('fiscal'), o mesmo padrão        ║
// ║  conservador que criar-usuario.cjs --migrar aplica. Negar seria trancar  ║
// ║  fora quem foi criado direto no Console antes dos claims existirem.      ║
// ║  Depois de rodar a migração, trocar para 'visualizador' é uma linha.     ║
// ║                                                                          ║
// ║  ESTRUTURA DE ARQUIVOS                                                   ║
// ║    obras/{obraId}/logo                     → logo da obra  (≤  2 MB)    ║
// ║    obras/{obraId}/docs/{arquivo}           → documentos    (≤ 20 MB)    ║
// ║    obras/{obraId}/fotos-medicao/{arquivo}  → fotos de BM   (≤ 10 MB)    ║
// ║    obras/{obraId}/diario/{arquivo}         → fotos diário  (≤ 10 MB)    ║
// ║    obras/{obraId}/ocorrencias/{arquivo}    → fotos ocorr.  (≤ 10 MB)    ║
// ╚══════════════════════════════════════════════════════════════════════════╝

service firebase.storage {
  match /b/{bucket}/o {

    // ═══════════════════════════════════════════════════════════════
    //  PAPÉIS — espelho de HIERARQUIA em utils/rbac.js
    // ═══════════════════════════════════════════════════════════════

    function autenticado() {
      return request.auth != null;
    }

    // Papel de quem não tem claim nenhum. Ver o cabeçalho antes de endurecer.
    function papelPadrao() {
      return 'fiscal';
    }

    function papel() {
      return request.auth.token.get('role', papelPadrao());
    }

    function nivel(p) {
      return p == 'administrador' ? 5
           : p == 'gestor'        ? 4
           : p == 'fiscal'        ? 3
           : p == 'engenheiro'    ? 2
           : p == 'tecnico'       ? 1
           : 0;  // visualizador e qualquer valor desconhecido
    }

    function adminGlobal() {
      return autenticado() && request.auth.token.get('adminGlobal', false) == true;
    }

    // Único portão de escrita: autenticado E (admin OU nível suficiente).
    function nivelMinimo(n) {
      return autenticado() && (adminGlobal() || nivel(papel()) >= n);
    }

    // ═══════════════════════════════════════════════════════════════
    //  LIMITES POR PASTA
    // ═══════════════════════════════════════════════════════════════

    function imagemOk(limiteMb) {
      return request.resource.size <= limiteMb * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function documentoOk() {
      return request.resource.size <= 20 * 1024 * 1024
        && (
          request.resource.contentType.matches('application/pdf') ||
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('application/vnd.ms-excel') ||
          request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet') ||
          request.resource.contentType.matches('application/msword') ||
          request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document') ||
          request.resource.contentType.matches('text/csv') ||
          request.resource.contentType.matches('text/plain')
        );
    }

    // ═══════════════════════════════════════════════════════════════
    //  obras/{obraId}/logo — logo da obra
    // ═══════════════════════════════════════════════════════════════
    match /obras/{obraId}/logo {
      allow read:   if autenticado();
      allow write:  if nivelMinimo(4) && imagemOk(2);
      allow delete: if nivelMinimo(4);
    }

    // ═══════════════════════════════════════════════════════════════
    //  obras/{obraId}/{pasta}/{arquivo} — documentos e fotos
    //
    //  Uma única regra para as quatro pastas que o app usa, com a lista
    //  explícita: pasta nova continua barrada até ser declarada aqui, de
    //  propósito. O que não pode voltar é o silêncio — foi ele que fez a
    //  foto de diário virar base64 dentro do Firestore.
    // ═══════════════════════════════════════════════════════════════
    match /obras/{obraId}/{pasta}/{arquivo} {

      allow read: if autenticado()
        && pasta in ['docs', 'fotos-medicao', 'diario', 'ocorrencias'];

      allow write: if nivelMinimo(1)
        && (
          (pasta == 'docs' && documentoOk()) ||
          (pasta in ['fotos-medicao', 'diario', 'ocorrencias'] && imagemOk(10))
        );

      allow delete: if nivelMinimo(4)
        && pasta in ['docs', 'fotos-medicao', 'diario', 'ocorrencias'];
    }

    // ═══════════════════════════════════════════════════════════════
    //  BLOQUEIO GLOBAL — qualquer caminho não mapeado
    // ═══════════════════════════════════════════════════════════════
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
